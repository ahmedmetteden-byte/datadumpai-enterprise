# Public Supabase client (safe for the browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Product API base URL. Leave empty in local dev to use Vite proxy (/api → :8000).
# Set to absolute URL in production once the FastAPI product API is deployed.
VITE_API_BASE_URL=

# Use mock data instead of HTTP (true for Phase 1)
VITE_USE_MOCK_API=true

# Optional: Vite proxy target for /api
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
