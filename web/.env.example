# =============================================================================
# DataDumpAI Enterprise — React SPA environment (REQUIRED)
# =============================================================================
# Copy this file to web/.env and fill in real values:
#   cp web/.env.example web/.env
#
# Vite ONLY loads env files from this directory (web/), NOT the repository root.
# The root .env is for FastAPI / Streamlit / Docker Compose backend services.
# Variables must be prefixed with VITE_ or they will NOT be visible in the browser.
#
# After changing any value, restart `npm run dev` (or rebuild the Docker image).
# =============================================================================

# --- Required: Supabase Auth (public anon key — safe for the browser) ---
# Same project URL / anon key as root SUPABASE_URL / SUPABASE_ANON_KEY, but
# they MUST be named with the VITE_ prefix for React.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Required for API calls without the Vite / nginx /api proxy ---
# Local Vite: http://localhost:8000 (or leave empty to use the Vite proxy).
# Docker/nginx (same-origin /api proxy): leave empty.
VITE_API_BASE_URL=http://localhost:8000

# --- Optional ---
# Offline UI demos only. Keep false for real Supabase + product API.
VITE_USE_MOCK_API=false

# Vite dev-server proxy target when VITE_API_BASE_URL is empty.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
