# OpenAI
OPENAI_API_KEY=your-openai-api-key

# ---------------------------------------------------------------------------
# Deployment environment
# ---------------------------------------------------------------------------
# development | staging | production
# AUTH_DEV_BYPASS is only honored when ENVIRONMENT=development.
ENVIRONMENT=production

# ---------------------------------------------------------------------------
# Supabase Authentication (required for multi-user mode)
# ---------------------------------------------------------------------------
# Create a Supabase project and enable:
#   - Email authentication
#   - Email confirmation
#   - Password reset
# Disable anonymous sign-ins.
#
# SUPABASE_ANON_KEY is safe for the frontend.
# SUPABASE_SERVICE_ROLE_KEY must stay on the server only — never expose it
# to the browser or commit it to version control.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=
# Product API verifies ES256 access tokens via JWKS at:
#   {SUPABASE_URL}/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_SECRET (HS256 shared secret) is no longer used by the SPA API.
# SUPABASE_JWT_SECRET=

# Optional aliases for the React Docker image build (docker-compose frontend build.args).
# If unset, compose falls back to SUPABASE_URL / SUPABASE_ANON_KEY above.
# For local Vite (`npm run dev`), you MUST still copy these into web/.env as VITE_*.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# VITE_API_BASE_URL=

# Where Supabase redirects after email verification or password reset.
# Must match a URL allowlisted in the Supabase dashboard exactly.
# Local Streamlit:  http://localhost:8501/?active_page=auth
# Production app:   https://app.getdatadump.com/?active_page=auth
# Do NOT use localhost in production — email links opened on phones will fail.
AUTH_REDIRECT_URL=https://app.getdatadump.com/?active_page=auth

# Base URL of the React SPA (no trailing slash) — used to build the billing
# return page URL below. Local Vite dev: http://localhost:5173
# Production app: https://app.getdatadump.com
APP_BASE_URL=https://app.getdatadump.com

# Legacy single-user dev auth — only when ENVIRONMENT=development.
# Must be false in staging and production. The app refuses to start if
# AUTH_DEV_BYPASS=true outside ENVIRONMENT=development.
AUTH_DEV_BYPASS=false

# ---------------------------------------------------------------------------
# Data storage
# ---------------------------------------------------------------------------

# Metadata storage: supabase (PostgreSQL) recommended for production
DATABASE_BACKEND=supabase

# File storage: supabase (Supabase Storage) recommended for production
STORAGE_BACKEND=supabase
SUPABASE_STORAGE_BUCKET=datadumpai-files

# Required when DATABASE_BACKEND=supabase
# SUPABASE_SERVICE_ROLE_KEY is set above.

# Account lockout (failed sign-in attempts)
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Payments (Stripe + Paystack)
PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PROFESSIONAL_PRICE_ID=
STRIPE_STARTER_AMOUNT_CENTS=1500
STRIPE_PROFESSIONAL_AMOUNT_CENTS=3900

PAYSTACK_SECRET_KEY=
PAYSTACK_STARTER_PLAN_CODE=
PAYSTACK_PROFESSIONAL_PLAN_CODE=
PAYSTACK_STARTER_AMOUNT_KOBO=2100000
PAYSTACK_PROFESSIONAL_AMOUNT_KOBO=5400000

# Defaults to {APP_BASE_URL}/billing/return if unset — only override if the
# return page needs to live somewhere other than APP_BASE_URL.
BILLING_SUCCESS_URL=https://app.getdatadump.com/billing/return
BILLING_CANCEL_URL=https://app.getdatadump.com/billing/return
BILLING_WEBHOOK_BASE_URL=http://localhost:8000

# Email notifications
EMAIL_ENABLED=false
EMAIL_FROM=noreply@datadumpai.com
EMAIL_FROM_NAME=DataDumpAI
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
RESEND_API_KEY=

# Admin access (comma-separated)
ADMIN_USER_IDS=
ADMIN_EMAILS=

# Analytics
ANALYTICS_ENABLED=false
ANALYTICS_PROVIDER=local
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com
PLAUSIBLE_DOMAIN=

# Launch
SITE_URL=https://www.getdatadump.com
DEBUG=false
RECOVERY_CALLBACK_TRACE=false

# ---------------------------------------------------------------------------
# Product API + vector index (Sprint 2)
# ---------------------------------------------------------------------------
# Local: QDRANT_URL=http://127.0.0.1:6333
# Docker compose service: QDRANT_URL=http://qdrant:6333
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=datadumpai_chunks
QDRANT_VECTOR_SIZE=1536
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
